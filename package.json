{
  "name": "farma-oglasi-pro",
  "version": "1.0.0",
  "private": true,
  "description": "FARMA OGLASI PRO - bilingual livestock, farming, veterinary and auction marketplace for Bosnia and Herzegovina.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace @farma/frontend",
    "dev:backend": "npm run dev --workspace @farma/backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @farma/backend",
    "db:seed": "npm run db:seed --workspace @farma/backend"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
